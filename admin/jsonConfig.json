{
  "type": "panel",
  "i18n": true,
  "items": {
    "_headerPrograms": {
      "type": "header",
      "text": "header_programs",
      "size": 5,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_deviceManager": {
      "type": "deviceManager",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_headerGeneral": {
      "newLine": true,
      "type": "header",
      "text": "header_general",
      "size": 5,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "pollInterval": {
      "type": "number",
      "label": "label_pollInterval",
      "help": "help_pollInterval",
      "min": 2,
      "max": 3600,
      "default": 10,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "treeScope": {
      "type": "select",
      "label": "label_treeScope",
      "help": "help_treeScope",
      "options": [
        {
          "label": "treeScope_all",
          "value": "all"
        },
        {
          "label": "treeScope_withoutCompleted",
          "value": "withoutCompleted"
        },
        {
          "label": "treeScope_unfinished",
          "value": "unfinished"
        }
      ],
      "default": "all",
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "maxDownloads": {
      "type": "number",
      "label": "label_maxDownloads",
      "help": "help_maxDownloads",
      "min": 0,
      "max": 1000,
      "step": 1,
      "default": 100,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_warnManyDownloads": {
      "newLine": true,
      "type": "infoBox",
      "boxType": "warning",
      "closeable": false,
      "title": "warnManyDownloads_title",
      "text": "warnManyDownloads_text",
      "hidden": "!(Number(data.maxDownloads) === 0 || Number(data.maxDownloads) > 200)",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_supportHeader": {
      "newLine": true,
      "type": "header",
      "text": "supportHeader",
      "size": 5
    },
    "_aboutInfo": {
      "type": "staticText",
      "text": "aboutInfo",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "style": {
        "fontSize": 14,
        "marginBottom": 16
      }
    },
    "_kofiLink": {
      "type": "staticLink",
      "href": "https://ko-fi.com/krobipd",
      "label": "donateKofi",
      "button": true,
      "variant": "outlined",
      "color": "primary",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_paypalLink": {
      "type": "staticLink",
      "href": "https://paypal.me/krobipd",
      "label": "donatePaypal",
      "button": true,
      "variant": "outlined",
      "color": "primary",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    }
  }
}
